{
  "name": "meshtastic-chat-card",
  "description": "Lovelace card that displays Meshtastic channel messages recorded by the meshtastic Home Assistant integration.",
  "repository": "https://github.com/ch0ppy35/meshtastic-integration-chat-log-card",
  "author": "Mike Miller",
  "version": "1.0.0",
  "module": "meshtastic-chat-card.js",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "hacs",
    "lovelace",
    "custom-cards",
    "meshtastic",
    "chat"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "home-assistant-js-websocket": "9.6.0",
    "lit": "3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.2",
    "globals": "^17.6.0",
    "jest": "^30.4.0",
    "jest-environment-jsdom": "^30.4.0",
    "prettier": "3.8.3",
    "rollup": "^4.60.3",
    "rollup-plugin-gzip": "^4.2.0",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "ts-jest": "^29.4.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.js --watch",
    "build": "yarn rollup",
    "lint": "eslint src/ --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "rollup": "rollup -c",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "packageManager": "yarn@4.14.1"
}
